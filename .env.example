# --- Clerk (client + server auth) -------------------------------------------
# Dashboard → API keys: https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Read by Convex, NOT by Vite. Set it on the deployment:
#   npx convex env set CLERK_SECRET_KEY sk_...
# The calendar action uses it to ask Clerk for the signed-in user's Google
# access token; without it sync reports "not configured" and changes nothing.
CLERK_SECRET_KEY=sk_test_xxx

# --- Convex ------------------------------------------------------------------
# Set automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# NOTE: CLERK_JWT_ISSUER_DOMAIN is NOT read from here. It belongs on the Convex
# deployment (read by convex/auth.config.ts):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev

# --- Feature flags (WIP gates; default off, set to '1' to enable) ------------
# Vite inlines these at build time, so flipping one needs a rebuild.
VITE_ENABLE_CALENDAR=
VITE_ENABLE_SPACES=

# --- Production checklist ----------------------------------------------------
# 1. Convex:  npx convex deploy, with CLERK_JWT_ISSUER_DOMAIN and
#    CLERK_SECRET_KEY already set on the production deployment.
# 2. Vercel:  set the two VITE_ values above plus both flags, then rebuild.
# 3. Clerk:   a production instance with Google as a social connection, and
#    https://www.googleapis.com/auth/calendar.events declared and verified as a
#    sensitive scope on the consent screen. A development instance cannot be
#    verified for a sensitive scope.
