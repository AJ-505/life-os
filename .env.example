# --- Clerk (client + server auth) -------------------------------------------
# Dashboard → API keys: https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Read by Convex, NOT by Vite. Set it on the deployment:
#   npx convex env set CLERK_SECRET_KEY sk_...
# The calendar action uses it to ask Clerk for the signed-in user's Google
# access token; without it sync reports "not configured" and changes nothing.
CLERK_SECRET_KEY=sk_test_xxx

# --- Convex ------------------------------------------------------------------
# Set automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# NOTE: CLERK_JWT_ISSUER_DOMAIN is NOT read from here. It belongs on the Convex
# deployment (read by convex/auth.config.ts):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev

# --- Dev sign-in (dev deployment only) ---------------------------------------
# Email and password sign-in for agents and local testing. Convex accepts it
# only when CONVEX_SITE_URL is the dev deployment host (convex/devAuth.ts), so
# it cannot work on production even if these variables were set there. Set on
# the Convex DEV deployment only (never --prod):
#   npx convex env set DEV_AUTH_ENABLED 1
#   npx convex env set DEV_AUTH_PRIVATE_JWK '<RSA private key as JWK JSON>'
#   npx convex env set DEV_AUTH_PASSWORD '<shared password>'
# scripts/check-dev-auth-off-in-prod.mjs fails the production build if any
# DEV_AUTH_ variable is set on the production deployment.
VITE_CONVEX_SITE_URL=
VITE_ENABLE_DEV_AUTH=
# Read by the dev server only, to sign in. Not exposed to the client bundle.
DEV_AUTH_PASSWORD=

# --- Feature flags (WIP gates; default off, set to '1' to enable) ------------
# Vite inlines these at build time, so flipping one needs a rebuild.
VITE_ENABLE_CALENDAR=
VITE_ENABLE_SPACES=

# --- Link previews -----------------------------------------------------------
# The absolute origin used for og:url and og:image (see src/seo.ts). Crawlers
# reject relative image URLs, so this cannot be derived at runtime. It falls
# back to https://lifeos-track.vercel.app, so it only needs setting if the
# domain changes — and then it needs a rebuild, not just a redeploy.
VITE_SITE_URL=

# --- Update notice -----------------------------------------------------------
# Production builds on Vercel bake in VERCEL_GIT_COMMIT_SHA. The Vercel build
# command is `pnpm run build:vercel`: after `convex deploy` it writes that sha
# to Convex with the deploy key Vercel already holds, and every open tab shows a
# Refresh toast once the new version has had time to go live. APP_BUILD_ID
# overrides the baked id, which is how to try the toast locally.
APP_BUILD_ID=

# --- Production checklist ----------------------------------------------------
# 1. Convex:  npx convex deploy, with CLERK_JWT_ISSUER_DOMAIN and
#    CLERK_SECRET_KEY already set on the production deployment.
# 2. Vercel:  set the two VITE_ values above plus both flags, then rebuild.
# 3. Clerk:   a production instance with Google as a social connection, and
#    https://www.googleapis.com/auth/calendar.events declared and verified as a
#    sensitive scope on the consent screen. A development instance cannot be
#    verified for a sensitive scope.
